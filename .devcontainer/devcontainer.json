{
	"name": "Misskey",
	"dockerComposeFile": "compose.yml",
	"service": "app",
	"workspaceFolder": "/workspace",
	"forwardPorts": [3000],
	"onCreateCommand": "/bin/bash .devcontainer/install-toolchain.sh",
	"postCreateCommand": "/bin/bash .devcontainer/init.sh",
	"customizations": {
		"vscode": {
			"extensions": [
				"editorconfig.editorconfig",
				"dbaeumer.vscode-eslint",
				"Vue.volar",
				"dbaeumer.vscode-eslint",
				"mrmlnc.vscode-json5"
			]
		}
	}
}
